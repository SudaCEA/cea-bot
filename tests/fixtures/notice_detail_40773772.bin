<script type="text/javascript">
function flashChecker(){
	var hasFlash=0;　　　　//是否安装了flash
	var flashVersion=0;　　//flash版本	
	if(document.all){
		var swf = false;
		try{
			 swf = new ActiveXObject('ShockwaveFlash.ShockwaveFlash');
		}catch(e){
			 swf = false;
		}
		if(swf) {
			hasFlash=1;
			VSwf=swf.GetVariable("$version");
			flashVersion=parseInt(VSwf.split(" ")[1].split(",")[0]);
		}
	}
	return {f:hasFlash,v:flashVersion};
}

$(document).ready(function() {
    var _lochref = location.href+'';
	if(_lochref.indexOf('/archivesfile/')!=-1 && _lochref.indexOf('/archivesfile/GW_')==-1){//
		
		if(document.getElementById("p_wf_moduleId")){
			if($("#p_wf_moduleId").val()=="92" || $("#p_wf_moduleId").val()=="93"){ 
				//不做处理
			}else{
				return;
			}
		}else{
			return;
		}


		
	}

	var myapi = null;
	if("undefined" != typeof api){
		myapi = api;
	}
	var uniqueId = 'uploadImg';
	var realFileNameInputId = 'infoPicName';
	var saveFileNameInputId = 'infoPicSaveName';
    uniqueId = replaceDollar(uniqueId);
    realFileNameInputId = replaceDollar(realFileNameInputId);
    saveFileNameInputId = replaceDollar(saveFileNameInputId);
	
	if('no' == 'yes'){
		/**-- --plupload---- --*/
		 var max_file_size_ = '500mb';
		 var uploadLimit = 0;
		 uploadLimit = uploadLimit*1 + 0;
	     var uploader = new plupload.Uploader({
	     	 id: 'uploader_uploadImg',
	         runtimes : 'html5,flash,silverlight,gears,browserplus',
	         browse_button : 'pickfiles_uploadImg',
	         container : 'div_uploadImg',
	         max_file_size : '500mb',
	         //chunk_size : '1000mb',
			 unique_names : false,
			 multi_selection : true,
	         url : '/defaultroot/public/upload/uploadify/uploader.jsp?dir=customform&makeYMdir=yes&thumbnail=800x999999_small;&domainId=0',
	         flash_swf_url : '/defaultroot/public/upload/plupload/plupload.flash.swf',
	         silverlight_xap_url : '/defaultroot/public/upload/plupload/plupload.silverlight.xap',
	         filters : [
	             {title : "所有文件", extensions : "rar,zip,7z,txt,pdf,xml,dwg,vsd,eml,msg,ceb,tif,tiff,key,iso,ofd,doc,docx,xls,xlsx,xlsm,ppt,pptx,pps,wps,mpp,odt,ods,odp,cebx,jpg,jpeg,gif,png,bmp,asf,wmv,wav,swf,flv,mp3,mp4,rm,rmvb,avi,"}
	             
	             
	             
	             
	             ,{title : "自定义文件",     extensions : "*"}
	         ]
	     });  
	    
	     whirPluploader = uploader;
	     window.up_uploadImg = uploader;
	     uploader.bind('Init', function(up, params) {
	         //初始化操作
			
				init.call(init, {dir:'customform', uniqueId:uniqueId, canModify:'no', realFileNameInputId:realFileNameInputId, saveFileNameInputId:saveFileNameInputId,openType:''});
			

			
	     });      
	     uploader.init();   
	     uploader.bind('FilesAdded', function(up, files) {
	     	 var uploaded = $('#'+uniqueId).find("#files").find("tr").length + files.length;
	     	 if(uploadLimit>0 && (uploaded > uploadLimit)){
		     	//此处修改，
                if(typeof(W) != "undefined"){
	     	 	    W.whir_alert(comm.whir_upload_1+uploadLimit+comm.whir_upload_2,function(){up.refresh();},null);
                }else{
                    whir_alert(comm.whir_upload_1+uploadLimit+comm.whir_upload_2,function(){up.refresh();},null);
                }
	     	 	$.each(files, function(i, file) {
	     	 		up.removeFile(file); 
	     	 	});   
	     	 }else if(compareFileSize(max_file_size_,files[0].size)=="<"){
	     	 	if(max_file_size_.indexOf("-")==0 || max_file_size_.indexOf("0")==0){
					if (false) {
						layer.alert(comm.whir_upload_3, {icon: 7,title: "提示"});
					} else {
						whir_alert(comm.whir_upload_3,function(){up.refresh();},null);
					}
	     	 	}else{
					if (false) {
						layer.alert(comm.whir_upload_4+max_file_size_, {icon: 7,title: "提示"});
					} else {
						whir_alert(comm.whir_upload_4+max_file_size_,function(){up.refresh();},null);
					}
	     	 	}
	     	 	$.each(files, function(i, file) {
	     	 		up.removeFile(file); 
	     	 	});   
	     	 }else if (false) {
					if (false) {
						layer.alert("您不在安全网段内，不可以使用此处的上传功能，请联系管理员！", {icon: 7,title: "提示"});
					} else {
						whir_alert("您不在安全网段内，不可以使用此处的上传功能，请联系管理员！",function(){up.refresh();},null);
					}
				$.each(files, function(i, file) {
	     	 		up.removeFile(file); 
	     	 	});
			 }else{
	     	     var b = false;
	     	     var allowtypes = ',*,';
		         $.each(files, function(i, file) { 
		             var filename = file.name;
		             var filetype = (','+filename.substring(filename.lastIndexOf(".")+1)+',').toLowerCase();
		             if(file.size==0){
						if (false) {
							layer.alert(comm.whir_upload_5, {icon: 7,title: "提示"});
						} else {
							whir_alert(comm.whir_upload_5,function(){up.refresh();},myapi);
						}
		             	
		             	b = true;
		             	up.removeFile(file); 
		             	//return false;
		             }else if(allowtypes.indexOf(filetype)< 0){
						if (false) {
							layer.alert(comm.whir_upload_6+"*", {icon: 7,title: "提示"});
						} else {
							whir_alert(comm.whir_upload_6+"*",function(){up.refresh();},myapi);
						}
		             	b = true;
		             	up.removeFile(file); 
		             	//return false;
                     }else if('customform'.indexOf('customform') != -1 && (filename.indexOf(",") != -1 || filename.indexOf(";") != -1)){
						if (false) {
							layer.alert(comm.whir_upload_invalidchar, {icon: 7,title: "提示"});
						} else {
							whir_alert(comm.whir_upload_invalidchar,function(){up.refresh();},myapi);
						}
		             	
		             	b = true;
		             	up.removeFile(file); 
		             	//return false;
		             }else if(filename.indexOf("'") > -1 || filename.indexOf("\‘") > -1){
						if (false) {
							layer.alert("文件名不能包含有特殊字符\',\’等", {icon: 7,title: "提示"});
						} else {
							whir_alert("文件名不能包含有特殊字符\',\’等",function(){up.refresh();},myapi);
						}
						
						b = true;
		             	up.removeFile(file);
					}else{

						 var file_name_date = "";
						 if($('#p_wf_processDefinitionKey',parent.document).length>0 && $('#p_wf_processDefinitionKey',parent.document).val()!='tzgg'){
							file_name_date = '10131428';
							var nname = file.name;
							var _name = nname.substring(0, nname.lastIndexOf("."));
							var _type = nname.substring(nname.lastIndexOf(".") , nname.length);

							console.log(_name+"---------" + _type);
							file.name = _name+file_name_date+_type;
						 }
						
			        	var select_json = 	{file:file, uniqueId:uniqueId, dir:'customform', realFileNameInputId:realFileNameInputId, saveFileNameInputId:saveFileNameInputId, files:files, uploader:uploader};	
																							
							onSelect.call(onSelect, select_json);
						
					 }
		         });
                 if(true){
                    uploader.start();
                 }
	         }
	     });    
	      
	     uploader.bind('UploadProgress', function(up, file) {
	         var progress_json =  {file:file, uniqueId:uniqueId, percent:file.percent, dir:'customform', realFileNameInputId:realFileNameInputId, saveFileNameInputId:saveFileNameInputId};
			 
				onUploadProgress.call(onUploadProgress, progress_json);
			 
	     });      
	     
	     uploader.bind('Error', function(up, err) {
	         if(err.code==-601){
	         	whir_alert(comm.whir_upload_6+"*",function(){up.refresh();},myapi);
	         }else if(err.code==-600){
				if (false) {
					layer.alert(comm.whir_upload_4+max_file_size_, {icon: 7,title: "提示"});
				} else {
					whir_alert(comm.whir_upload_4+max_file_size_,function(){up.refresh();},myapi);
				}
	         }
	         
	     });  
	
	     uploader.bind('FileUploaded', function(up, file, data) {
	         var json =  eval("("+data.response+")");
			 

			 var file_name_date = "";
			 if($('#p_wf_processDefinitionKey',parent.document).length>0 && $('#p_wf_processDefinitionKey',parent.document).val()!='tzgg'){
				file_name_date = '10131428';
			 }

	
			 var success_json = {dlcode:json.dlcode, file_type:json.file_type, save_name:json.save_name, file_name: json.file_name+file_name_date, relative_path:json.relative_path, file_size:file.size, uniqueId:uniqueId, dir:'customform', realFileNameInputId:realFileNameInputId, saveFileNameInputId:saveFileNameInputId};
			 
				onUploadSuccess.call(onUploadSuccess, success_json);
			 	
			 //我的文档容量,更新当前fileSizeLimit
			 
	     });

         if($.browser.opera || whir_agent.indexOf("MSIE 10")>=0 ){
             var _plupload = $('div.plupload[id$=_html5_container]'); 
             _plupload.css('height', _plupload.parent().height()).css('width', _plupload.parent().width());
         }
	}else{
		//初始化操作
		
			init.call(init,{dir:'customform',uniqueId:uniqueId,canModify:'no',realFileNameInputId:realFileNameInputId,saveFileNameInputId:saveFileNameInputId,openType:''});
		
	}
	
	if($(".doc_width").length>0){
		$("#uploadImg").closest("td").css("padding-left","5px");
	}
});
</script>

<script type="text/javascript">
/**
	//禁止页面查看源代码和F12键调试  开始
	document.oncontextmenu=new Function("return false")
	//document.onselectstart=new Function("return false") 

	document.onkeydown=function (e){
        var currKey=0,evt=e||window.event;
        currKey=evt.keyCode||evt.which||evt.charCode;
        if (currKey == 123) {
			//火狐禁止不了F12，特殊处理  开始
			var userAgent = window.navigator.userAgent.toLowerCase();  
			if(userAgent.indexOf("firefox")!=-1){
				window.close();
				if(window.parent){
					window.parent.close();
				}
			}
			//火狐禁止不了F12，特殊处理  结束
			window.event.keyCode=0;
            window.event.cancelBubble = true;
            window.event.returnValue = false;
        }
    }
	//禁止页面查看源代码和F12键调试  结束**/
</script>
