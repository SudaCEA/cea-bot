<script>
 function open_tz(id){
   window.open('/defaultroot/gov/info_view_my.jsp?whir_new_verifyCode=1&editId='+id,'','');
   //alert(document.cookie);
 }

 function searchT(){
	 var title="";
  var s_date=document.all.s_date.value;
   var e_date=document.all.e_date.value;
   var f_org=document.all.f_org.value;
   var all_text=document.all.all_text.value;
   var tt = document.all.tt.value;
   var type="1";
	if(type==1){
	 title="校内通知";
	}else if(type==2){title="学校发文";}else if(type==3){title="学术报告";}else if(type==4){title="历史通知发文";}else if(type==5){title="帮助";}

   location.href="/defaultroot/SInformAction.do?action=init&type="+type+"&title="+title+"&tt="+tt+"&s_date="+s_date+"&e_date="+e_date+"&f_org="+f_org+"&all_text="+all_text;
 }
</script>
